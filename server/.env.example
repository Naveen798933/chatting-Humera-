PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/chat
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=LoveChat <no-reply@lovechat.local>
# Set SMTP_HOST and auth values to send real OTP emails. If left empty, OTPs are shown in the app response and logged to the server console.
APP_DEFAULT_ROOM_NAME=Private Room
UPLOAD_DIR=uploads
