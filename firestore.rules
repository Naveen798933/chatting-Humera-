rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hardcoded Authorized UIDs for Naveen & Humera (Section 3 & Section 14)
    function isUniverseUser() {
      return request.auth != null && (
        request.auth.uid == "naveen_uid_798933" || 
        request.auth.uid == "humera_uid_140299"
      );
    }

    // Owner check for administrative actions
    function isOwner() {
      return request.auth != null && request.auth.uid == "naveen_uid_798933";
    }

    // Global Collections Access Boundary
    match /users/{userId} {
      allow read, write: if isUniverseUser();
    }

    match /config/{configId} {
      allow read: if isUniverseUser();
      allow write: if isOwner();
    }

    match /conversations/{convId}/messages/{messageId} {
      allow read, write: if isUniverseUser();
    }

    match /memories/{memoryId} {
      allow read, write: if isUniverseUser();
    }

    match /vault/{noteId} {
      allow read, write: if isUniverseUser();
    }

    match /calendar/{eventId} {
      allow read, write: if isUniverseUser();
    }

    match /todos/{todoId} {
      allow read, write: if isUniverseUser();
    }

    match /mappins/{pinId} {
      allow read, write: if isUniverseUser();
    }

    // Reject all third-party access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
